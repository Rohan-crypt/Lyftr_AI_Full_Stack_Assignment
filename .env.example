# LiteLLM key pool (comma-separated, at least 2 keys)
# Key ids assigned in order: key_1, key_2, ...
LLM_API_KEYS=your_first_gemini_or_openai_api_key,your_second_gemini_or_openai_api_key

# SQLite database location (persistent named Docker volume: /data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook via X-Simulate-Failure header (required on deployed backend)
ENABLE_FAILURE_SIMULATION=true

# Model name for LiteLLM gateway
DEFAULT_MODEL=gemini/gemini-flash-lite-latest
